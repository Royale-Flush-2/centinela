# Centinela Platform Environment Variables

# Global & Runtime Configuration
CENTINELA_ENV=dev
CENTINELA_LOG_LEVEL=INFO

# Cloud & Infrastructure (AWS)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# Database & Knowledge Store
CENTINELA_DATABASE_URL=postgresql://postgres@localhost:5432/postgres
CENTINELA_STATEMENT_TIMEOUT=5000
CENTINELA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM & AI Services
CENTINELA_DEEPSEEK_API_KEY=

# Internal Microservice URLs (Service Discovery)
CENTINELA_ORCHESTRATOR_URL=http://orchestrator.centinela.internal:8004/orchestrate
CENTINELA_CLUSTERING_URL=http://clustering.centinela.internal:8001/analyze
CENTINELA_MCP_SERVER_URL=http://postgres-mcp.centinela.internal:8006/sse
CENTINELA_KNOWLEDGE_SERVICE_URL=http://knowledge.centinela.internal:8007/api/v1/knowledge/search
